# Supabase — copy this file to .env.local and fill in real values.
# Dashboard → Project Settings → API.
# The anon key is safe to expose to the browser (RLS protects your data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only (NEVER prefix with NEXT_PUBLIC). Used later for admin tasks/exports.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
